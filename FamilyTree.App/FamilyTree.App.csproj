<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <LangVersion>latest</LangVersion>
    <UseWPF>true</UseWPF>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <!-- Іконка самого .exe: саме її показують Проводник, панель задач, ярлики
         інсталятора та асоціація .familytree (FamilyTree.iss посилається на
         "{app}\FamilyTree.exe,0"). Без цього рядка там була стандартна іконка .NET. -->
    <ApplicationIcon>Resources\app-icon.ico</ApplicationIcon>
    <AssemblyName>FamilyTree</AssemblyName>
    <RootNamespace>FamilyTree.App</RootNamespace>
    <RuntimeIdentifiers>win-x64</RuntimeIdentifiers>
    <Version>0.9.3</Version>
    <AssemblyVersion>0.9.3.0</AssemblyVersion>
    <FileVersion>0.9.3.0</FileVersion>
    <InformationalVersion>0.9.3</InformationalVersion>
    <Product>Family Tree</Product>
    <Description>Family Tree — застосунок для побудови й перегляду родинного дерева (передрелізна версія 0.9.2).</Description>
    <!-- Єдине джерело даних про автора: звідси їх читають властивості .exe,
         вікно «Про програму» (AboutViewModel) та інсталятор. -->
    <Authors>Oleh Kulman</Authors>
    <Company>Oleh Kulman</Company>
    <Copyright>© 2026 Oleh Kulman</Copyright>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
  </PropertyGroup>

  <!-- Налаштування публікації в один самодостатній .exe (див. Properties\PublishProfiles).
       Діють лише під час `dotnet publish`, звичайний build/debug не зачіпають. -->
  <PropertyGroup Condition="'$(PublishSingleFile)' == 'true'">
    <SelfContained>true</SelfContained>
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
    <EnableCompressionInSingleFile>true</EnableCompressionInSingleFile>
    <DebugType>embedded</DebugType>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="CommunityToolkit.Mvvm" Version="8.4.0" />
    <PackageReference Include="Microsoft.Extensions.Hosting" Version="10.0.0" />
    <PackageReference Include="Serilog" Version="4.2.0" />
    <PackageReference Include="Serilog.Sinks.File" Version="6.0.0" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\FamilyTree.Domain\FamilyTree.Domain.csproj" />
    <ProjectReference Include="..\FamilyTree.Storage\FamilyTree.Storage.csproj" />
  </ItemGroup>

  <!-- Іконка всередині застосунку: .ico для заголовка вікна (Windows сам обирає
       потрібний кадр із 16…256), .png для картинки в діалозі «Про програму».
       None Remove — щоб файли не потрапили одночасно і як None, і як Resource. -->
  <ItemGroup>
    <None Remove="Resources\app-icon.ico" />
    <None Remove="Resources\app-icon.png" />
    <Resource Include="Resources\app-icon.ico" />
    <Resource Include="Resources\app-icon.png" />
  </ItemGroup>

</Project>
