<Window x:Class="FamilyTree.App.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:loc="clr-namespace:FamilyTree.App.Localization"
        Title="{loc:Localize Settings_Title}"
        Height="380" Width="440"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        Background="{DynamicResource BackgroundBrush}">
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <!-- Мова -->
        <TextBlock Grid.Row="0" Grid.Column="0" Text="{loc:Localize Settings_Language}"
                   Style="{StaticResource SecondaryTextStyle}" VerticalAlignment="Center" Margin="0,0,16,12" />
        <ComboBox Grid.Row="0" Grid.Column="1" Style="{StaticResource InputComboBoxStyle}" Margin="0,0,0,12"
                  ItemsSource="{Binding AvailableLanguages}" SelectedItem="{Binding SelectedLanguage}"
                  ItemTemplate="{StaticResource OptionDisplayTemplate}" />

        <!-- Тема -->
        <TextBlock Grid.Row="1" Grid.Column="0" Text="{loc:Localize Settings_Theme}"
                   Style="{StaticResource SecondaryTextStyle}" VerticalAlignment="Center" Margin="0,0,16,12" />
        <ComboBox Grid.Row="1" Grid.Column="1" Style="{StaticResource InputComboBoxStyle}" Margin="0,0,0,12"
                  ItemsSource="{Binding AvailableThemes}" SelectedItem="{Binding SelectedTheme}"
                  ItemTemplate="{StaticResource OptionDisplayTemplate}" />

        <!-- Стиль назв родства -->
        <TextBlock Grid.Row="2" Grid.Column="0" Text="{loc:Localize Settings_Naming}"
                   Style="{StaticResource SecondaryTextStyle}" VerticalAlignment="Center" Margin="0,0,16,12" />
        <ComboBox Grid.Row="2" Grid.Column="1" Style="{StaticResource InputComboBoxStyle}" Margin="0,0,0,12"
                  ItemsSource="{Binding AvailableNamingStyles}" SelectedItem="{Binding SelectedNamingStyle}"
                  ItemTemplate="{StaticResource OptionDisplayTemplate}" />

        <!-- Глибина дерева за замовчуванням -->
        <TextBlock Grid.Row="3" Grid.Column="0" Text="{loc:Localize Settings_DefaultDepth}"
                   Style="{StaticResource SecondaryTextStyle}" VerticalAlignment="Center" Margin="0,0,16,12" />
        <ComboBox Grid.Row="3" Grid.Column="1" Style="{StaticResource InputComboBoxStyle}" Margin="0,0,0,12"
                  ItemsSource="{Binding DepthOptions}" SelectedItem="{Binding DefaultDepth}">
            <ComboBox.ItemTemplate>
                <DataTemplate>
                    <TextBlock Text="{Binding Converter={StaticResource DepthLabelConverter}}" />
                </DataTemplate>
            </ComboBox.ItemTemplate>
        </ComboBox>

        <!-- Останні файли -->
        <TextBlock Grid.Row="4" Grid.Column="0" Text="{loc:Localize Menu_Recent}"
                   Style="{StaticResource SecondaryTextStyle}" VerticalAlignment="Center" Margin="0,0,16,12" />
        <StackPanel Grid.Row="4" Grid.Column="1" Orientation="Horizontal" Margin="0,0,0,12">
            <TextBlock Text="{Binding RecentFilesCount}" VerticalAlignment="Center"
                       Foreground="{DynamicResource TextPrimaryBrush}" Margin="0,0,12,0" />
            <Button Content="{loc:Localize Settings_ClearRecent}" Padding="10,4"
                    Command="{Binding ClearRecentFilesCommand}" />
        </StackPanel>

        <!-- Кнопка закриття -->
        <Button Grid.Row="6" Grid.Column="1" Content="{loc:Localize Common_Close}" MinWidth="90"
                HorizontalAlignment="Right" Margin="0,16,0,0"
                Style="{StaticResource PrimaryButtonStyle}" IsCancel="True" Click="Close_Click" />
    </Grid>
</Window>
