<Window x:Class="FamilyTree.App.AboutWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:loc="clr-namespace:FamilyTree.App.Localization"
        Title="{loc:Localize About_Title}"
        Width="420" SizeToContent="Height"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        Background="{DynamicResource BackgroundBrush}">
    <StackPanel Margin="24">
        <StackPanel Orientation="Horizontal" Margin="0,0,0,14">
            <Image Source="{StaticResource AppIcon}" Width="48" Height="48"
                   VerticalAlignment="Center" Margin="0,0,14,0" />
            <StackPanel VerticalAlignment="Center">
                <TextBlock Text="{Binding ProductName}" Style="{StaticResource HeadingTextStyle}" />
                <StackPanel Orientation="Horizontal" Margin="0,2,0,0">
                    <TextBlock Text="{loc:Localize About_Version}" Style="{StaticResource SecondaryTextStyle}" Margin="0,0,6,0" />
                    <TextBlock Text="{Binding Version}" Style="{StaticResource SecondaryTextStyle}" />
                </StackPanel>
            </StackPanel>
        </StackPanel>

        <TextBlock Text="{loc:Localize About_Description}" TextWrapping="Wrap"
                   Foreground="{DynamicResource TextPrimaryBrush}" Margin="0,0,0,10" />
        <TextBlock Text="{loc:Localize About_Privacy}" TextWrapping="Wrap"
                   Style="{StaticResource SecondaryTextStyle}" />

        <Button Content="{loc:Localize Common_Close}" MinWidth="90" HorizontalAlignment="Right"
                Margin="0,20,0,0" Style="{StaticResource PrimaryButtonStyle}"
                IsCancel="True" Click="Close_Click" />
    </StackPanel>
</Window>
