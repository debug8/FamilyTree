<Window x:Class="FamilyTree.App.ChoiceWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:loc="clr-namespace:FamilyTree.App.Localization"
        Title="{Binding Title}"
        SizeToContent="Height"
        Width="440" MinHeight="150"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        Background="{DynamicResource BackgroundBrush}">
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Text="{Binding Message}" TextWrapping="Wrap" FontSize="13"
                   Foreground="{DynamicResource TextPrimaryBrush}" />

        <StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,20,0,0">
            <Button Content="{loc:Localize Common_Later}" MinWidth="110" Margin="0,0,10,0"
                    IsCancel="True" Click="Later_Click" />
            <Button Content="{loc:Localize Common_No}" MinWidth="90" Margin="0,0,10,0"
                    Click="No_Click" />
            <Button Content="{loc:Localize Common_Yes}" MinWidth="90"
                    Style="{StaticResource PrimaryButtonStyle}"
                    IsDefault="True" Click="Yes_Click" />
        </StackPanel>
    </Grid>
</Window>
