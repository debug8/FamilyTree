<Window x:Class="FamilyTree.App.PersonEditorWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:loc="clr-namespace:FamilyTree.App.Localization"
        xmlns:controls="clr-namespace:FamilyTree.App.Controls"
        Title="{Binding TitleKey, Converter={StaticResource LocalizeConverter}}"
        Height="560" Width="440"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        Background="{DynamicResource BackgroundBrush}">
    <Window.Resources>
        <Style TargetType="TextBlock" x:Key="FieldLabel" BasedOn="{StaticResource SecondaryTextStyle}">
            <Setter Property="Margin" Value="0,10,0,3" />
        </Style>
    </Window.Resources>

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <ScrollViewer Grid.Row="0" VerticalScrollBarVisibility="Auto">
            <StackPanel>
                <TextBlock Text="{loc:Localize Person_LastName}" Style="{StaticResource FieldLabel}" />
                <TextBox Style="{StaticResource InputTextBoxStyle}"
                         Text="{Binding LastName, UpdateSourceTrigger=PropertyChanged, ValidatesOnNotifyDataErrors=True}" />

                <TextBlock Text="{loc:Localize Person_FirstName}" Style="{StaticResource FieldLabel}" />
                <TextBox Style="{StaticResource InputTextBoxStyle}"
                         Text="{Binding FirstName, UpdateSourceTrigger=PropertyChanged, ValidatesOnNotifyDataErrors=True}" />

                <TextBlock Text="{loc:Localize Person_MiddleName}" Style="{StaticResource FieldLabel}" />
                <TextBox Style="{StaticResource InputTextBoxStyle}"
                         Text="{Binding MiddleName, UpdateSourceTrigger=PropertyChanged}" />

                <TextBlock Text="{loc:Localize Person_MaidenName}" Style="{StaticResource FieldLabel}" />
                <TextBox Style="{StaticResource InputTextBoxStyle}"
                         Text="{Binding MaidenName, UpdateSourceTrigger=PropertyChanged}" />

                <TextBlock Text="{loc:Localize Person_Gender}" Style="{StaticResource FieldLabel}" />
                <ComboBox Style="{StaticResource InputComboBoxStyle}"
                          HorizontalAlignment="Left" MinWidth="200"
                          ItemsSource="{Binding Genders}"
                          SelectedItem="{Binding SelectedGender, ValidatesOnNotifyDataErrors=True}">
                    <ComboBox.ItemTemplate>
                        <DataTemplate>
                            <TextBlock Text="{Binding NameKey, Converter={StaticResource LocalizeConverter}}" />
                        </DataTemplate>
                    </ComboBox.ItemTemplate>
                </ComboBox>

                <GroupBox Header="{loc:Localize Person_BirthDate}" Style="{StaticResource FieldGroupBox}">
                    <controls:FamilyDateEditor Value="{Binding BirthDate}" />
                </GroupBox>

                <TextBlock Text="{loc:Localize Person_BirthPlace}" Style="{StaticResource FieldLabel}" />
                <TextBox Style="{StaticResource InputTextBoxStyle}"
                         Text="{Binding BirthPlace, UpdateSourceTrigger=PropertyChanged}" />

                <CheckBox Content="{loc:Localize Person_IsAlive}" IsChecked="{Binding IsAlive}"
                          Foreground="{DynamicResource TextPrimaryBrush}" Margin="0,14,0,0" />

                <GroupBox Header="{loc:Localize Person_DeathDate}" Style="{StaticResource FieldGroupBox}"
                          Visibility="{Binding ShowDeathDate, Converter={StaticResource BoolToVisibility}}">
                    <controls:FamilyDateEditor Value="{Binding DeathDate}" />
                </GroupBox>

                <TextBlock Text="{loc:Localize Person_Photo}" Style="{StaticResource FieldLabel}" />
                <StackPanel Orientation="Horizontal">
                    <!-- Рамка-заглушка тримає розмір, коли фото ще немає -->
                    <Border Width="92" Height="112" CornerRadius="6"
                            Background="{DynamicResource SurfaceBrush}"
                            BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1">
                        <Grid>
                            <TextBlock Text="{loc:Localize Photo_None}" FontSize="11"
                                       Foreground="{DynamicResource TextSecondaryBrush}"
                                       HorizontalAlignment="Center" VerticalAlignment="Center"
                                       TextWrapping="Wrap" TextAlignment="Center" Margin="6"
                                       Visibility="{Binding HasNoPhoto, Converter={StaticResource BoolToVisibility}}" />
                            <Image Source="{Binding PhotoPreview}" Stretch="UniformToFill"
                                   Visibility="{Binding HasPhoto, Converter={StaticResource BoolToVisibility}}" />
                        </Grid>
                    </Border>

                    <StackPanel VerticalAlignment="Center" Margin="12,0,0,0">
                        <Button Content="{loc:Localize Photo_Choose}" MinWidth="120" Padding="10,4"
                                Command="{Binding PickPhotoCommand}" IsEnabled="{Binding CanPickPhoto}" />
                        <Button Content="{loc:Localize Photo_Remove}" MinWidth="120" Padding="10,4" Margin="0,6,0,0"
                                Command="{Binding RemovePhotoCommand}" IsEnabled="{Binding HasPhoto}" />
                        <TextBlock Text="{Binding PhotoError}" Foreground="{DynamicResource ErrorBrush}"
                                   FontSize="12" TextWrapping="Wrap" MaxWidth="220" Margin="0,6,0,0" />
                    </StackPanel>
                </StackPanel>

                <TextBlock Text="{loc:Localize Person_Facts}" Style="{StaticResource FieldLabel}" />
                <ItemsControl ItemsSource="{Binding Facts}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1"
                                    CornerRadius="6" Padding="8" Margin="0,0,0,8">
                                <StackPanel>
                                    <DockPanel>
                                        <Button DockPanel.Dock="Right" Content="✕" Width="26" Padding="0"
                                                VerticalAlignment="Center"
                                                ToolTip="{loc:Localize Person_Fact_Remove}"
                                                Command="{Binding DataContext.RemoveFactCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                CommandParameter="{Binding}" />

                                        <!-- Вид із новішої збірки міняти нема на що: показуємо
                                             його назву текстом. Згорнутий TextBlock місця не займає,
                                             тож обидва варіанти можуть стояти в одному DockPanel. -->
                                        <TextBlock DockPanel.Dock="Left" Text="{Binding CustomKindText}"
                                                   VerticalAlignment="Center" FontStyle="Italic"
                                                   Foreground="{DynamicResource TextSecondaryBrush}"
                                                   Visibility="{Binding IsCustomKind, Converter={StaticResource BoolToVisibility}}" />

                                        <ComboBox Style="{StaticResource InputComboBoxStyle}"
                                                  HorizontalAlignment="Left" MinWidth="170"
                                                  ItemsSource="{Binding KindOptions}"
                                                  SelectedItem="{Binding SelectedKind}"
                                                  Visibility="{Binding IsKnownKind, Converter={StaticResource BoolToVisibility}}">
                                            <ComboBox.ItemTemplate>
                                                <DataTemplate>
                                                    <TextBlock Text="{Binding NameKey, Converter={StaticResource LocalizeConverter}}" />
                                                </DataTemplate>
                                            </ComboBox.ItemTemplate>
                                        </ComboBox>
                                    </DockPanel>

                                    <TextBlock Text="{loc:Localize Person_Fact_Value}" Style="{StaticResource FieldLabel}" />
                                    <TextBox Style="{StaticResource InputTextBoxStyle}"
                                             Text="{Binding Value, UpdateSourceTrigger=PropertyChanged}" />

                                    <TextBlock Text="{loc:Localize Person_Fact_Place}" Style="{StaticResource FieldLabel}" />
                                    <TextBox Style="{StaticResource InputTextBoxStyle}"
                                             Text="{Binding Place, UpdateSourceTrigger=PropertyChanged}" />

                                    <GroupBox Header="{loc:Localize Person_Fact_Date}" Style="{StaticResource FieldGroupBox}">
                                        <controls:FamilyDateEditor Value="{Binding Date}" />
                                    </GroupBox>
                                </StackPanel>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
                <Button Content="{loc:Localize Person_Fact_Add}" HorizontalAlignment="Left"
                        Padding="10,4" Margin="0,2,0,0" Command="{Binding AddFactCommand}" />

                <TextBlock Text="{loc:Localize Person_Notes}" Style="{StaticResource FieldLabel}" />
                <TextBox Style="{StaticResource InputTextBoxStyle}"
                         AcceptsReturn="True" TextWrapping="Wrap" MinHeight="60"
                         Text="{Binding Notes, UpdateSourceTrigger=PropertyChanged}" />
            </StackPanel>
        </ScrollViewer>

        <StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
            <Button Content="{loc:Localize Common_Cancel}" MinWidth="90" Margin="0,0,10,0"
                    IsCancel="True" Click="Cancel_Click" />
            <Button Content="{loc:Localize Common_Save}" MinWidth="90"
                    Style="{StaticResource PrimaryButtonStyle}"
                    IsEnabled="{Binding CanSave}" Click="Save_Click" />
        </StackPanel>
    </Grid>
</Window>
