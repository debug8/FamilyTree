<UserControl x:Class="FamilyTree.App.Controls.FamilyGraphSurface"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!-- Полотно сцени: рамки-пари (позаду), ребра, вузли. Джерела даних і розмір —
         через DependencyProperties (звертаємось до них через RelativeSource на цей UserControl,
         щоб працювало і всередині шаблонів); взаємодія — через події (клік/наведення). -->
    <Canvas Width="{Binding SceneWidth, RelativeSource={RelativeSource AncestorType=UserControl}}"
            Height="{Binding SceneHeight, RelativeSource={RelativeSource AncestorType=UserControl}}"
            HorizontalAlignment="Left" VerticalAlignment="Top">

        <!-- Смуги-фони поколінь (найглибший шар) -->
        <ItemsControl ItemsSource="{Binding BandsSource, RelativeSource={RelativeSource AncestorType=UserControl}}">
            <ItemsControl.ItemsPanel>
                <ItemsPanelTemplate><Canvas /></ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
            <ItemsControl.ItemContainerStyle>
                <Style TargetType="ContentPresenter">
                    <Setter Property="Canvas.Left" Value="{Binding X}" />
                    <Setter Property="Canvas.Top" Value="{Binding Y}" />
                </Style>
            </ItemsControl.ItemContainerStyle>
            <ItemsControl.ItemTemplate>
                <DataTemplate>
                    <Rectangle Width="{Binding Width}" Height="{Binding Height}" Fill="{Binding Fill}"
                               IsHitTestVisible="False" />
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>

        <!-- Рамки подружжя (чинний шлюб) -->
        <ItemsControl ItemsSource="{Binding CouplesSource, RelativeSource={RelativeSource AncestorType=UserControl}}">
            <ItemsControl.ItemsPanel>
                <ItemsPanelTemplate><Canvas /></ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
            <ItemsControl.ItemContainerStyle>
                <Style TargetType="ContentPresenter">
                    <Setter Property="Canvas.Left" Value="{Binding X}" />
                    <Setter Property="Canvas.Top" Value="{Binding Y}" />
                </Style>
            </ItemsControl.ItemContainerStyle>
            <ItemsControl.ItemTemplate>
                <DataTemplate>
                    <Border Width="{Binding Width}" Height="{Binding Height}" CornerRadius="12"
                            Background="#22D64545" BorderBrush="#D64545" BorderThickness="1.5"
                            ToolTip="{Binding Tooltip}"
                            ToolTipService.InitialShowDelay="350" ToolTipService.ShowDuration="30000"
                            ToolTipService.IsEnabled="{Binding Interactive, RelativeSource={RelativeSource AncestorType=UserControl}}"
                            MouseEnter="Couple_MouseEnter" MouseLeave="Surface_PointerLeave" />
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>

        <!-- Ребра -->
        <ItemsControl ItemsSource="{Binding EdgesSource, RelativeSource={RelativeSource AncestorType=UserControl}}">
            <ItemsControl.ItemsPanel>
                <ItemsPanelTemplate><Canvas /></ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
            <ItemsControl.ItemTemplate>
                <DataTemplate>
                    <Canvas>
                        <!-- Прозора товста лінія — зручна зона наведення -->
                        <Line X1="{Binding X1}" Y1="{Binding Y1}" X2="{Binding X2}" Y2="{Binding Y2}"
                              Stroke="Transparent" StrokeThickness="10"
                              ToolTip="{Binding Tooltip}"
                              ToolTipService.InitialShowDelay="350" ToolTipService.ShowDuration="30000"
                              ToolTipService.IsEnabled="{Binding Interactive, RelativeSource={RelativeSource AncestorType=UserControl}}"
                              MouseEnter="Edge_MouseEnter" MouseLeave="Surface_PointerLeave" />
                        <!-- Видима лінія -->
                        <Line X1="{Binding X1}" Y1="{Binding Y1}" X2="{Binding X2}" Y2="{Binding Y2}"
                              IsHitTestVisible="False">
                            <Line.Style>
                                <Style TargetType="Line">
                                    <Setter Property="Stroke" Value="{DynamicResource TreeEdgeBrush}" />
                                    <Setter Property="StrokeThickness" Value="1.5" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsSpouse}" Value="True">
                                            <Setter Property="Stroke" Value="{DynamicResource AccentBrush}" />
                                            <Setter Property="StrokeDashArray" Value="3 2" />
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding IsHighlighted}" Value="True">
                                            <Setter Property="Stroke" Value="#FF8C00" />
                                            <Setter Property="StrokeThickness" Value="3.5" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Line.Style>
                        </Line>
                    </Canvas>
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>

        <!-- Вузли -->
        <ItemsControl ItemsSource="{Binding NodesSource, RelativeSource={RelativeSource AncestorType=UserControl}}">
            <ItemsControl.ItemsPanel>
                <ItemsPanelTemplate><Canvas /></ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
            <ItemsControl.ItemContainerStyle>
                <Style TargetType="ContentPresenter">
                    <Setter Property="Canvas.Left" Value="{Binding X}" />
                    <Setter Property="Canvas.Top" Value="{Binding Y}" />
                </Style>
            </ItemsControl.ItemContainerStyle>
            <ItemsControl.ItemTemplate>
                <DataTemplate>
                    <Border Width="{Binding Width}" Height="{Binding Height}" CornerRadius="8"
                            Background="{DynamicResource SurfaceBrush}" BorderThickness="1.5" Cursor="Hand"
                            MouseLeftButtonDown="Node_MouseLeftButtonDown"
                            MouseEnter="Node_MouseEnter" MouseLeave="Surface_PointerLeave"
                            ToolTipService.InitialShowDelay="350" ToolTipService.ShowDuration="60000"
                            ToolTipService.BetweenShowDelay="0"
                            ToolTipService.IsEnabled="{Binding Interactive, RelativeSource={RelativeSource AncestorType=UserControl}}">
                        <Border.ToolTip>
                            <!-- Сама картка — спільний шаблон PersonCardTemplate (App.xaml),
                                 той самий, що й у рядках родичів на вкладці «Особа». -->
                            <ToolTip Background="Transparent" BorderThickness="0" Padding="0" HasDropShadow="True"
                                     Content="{Binding Card}"
                                     ContentTemplate="{StaticResource PersonCardTemplate}" />
                        </Border.ToolTip>
                        <Border.Style>
                            <Style TargetType="Border">
                                <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsRoot}" Value="True">
                                        <Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
                                        <Setter Property="BorderThickness" Value="2.5" />
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding IsSelected}" Value="True">
                                        <Setter Property="BorderBrush" Value="{DynamicResource PrimaryBrush}" />
                                        <Setter Property="BorderThickness" Value="2.5" />
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding IsHighlighted}" Value="True">
                                        <Setter Property="BorderBrush" Value="#FF8C00" />
                                        <Setter Property="BorderThickness" Value="2.5" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Border.Style>
                        <StackPanel Margin="10,8" VerticalAlignment="Center">
                            <TextBlock Text="{Binding RelationBadge}" FontSize="11"
                                       Foreground="{DynamicResource PrimaryBrush}"
                                       Visibility="{Binding RelationBadge, Converter={StaticResource NullToCollapsedConverter}}" />
                            <TextBlock Text="{Binding NamePrimary}" FontSize="13" FontWeight="SemiBold"
                                       TextTrimming="CharacterEllipsis"
                                       Foreground="{DynamicResource TextPrimaryBrush}" />
                            <TextBlock Text="{Binding Patronymic}" FontSize="13" FontWeight="SemiBold"
                                       TextTrimming="CharacterEllipsis"
                                       Foreground="{DynamicResource TextPrimaryBrush}"
                                       Visibility="{Binding Patronymic, Converter={StaticResource NullToCollapsedConverter}}" />
                            <TextBlock Text="{Binding Years}" FontSize="11"
                                       Foreground="{DynamicResource TextSecondaryBrush}" />
                        </StackPanel>
                    </Border>
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>
    </Canvas>
</UserControl>
